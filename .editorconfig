# EditorConfig is awesome: https://EditorConfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C# files
[*.cs]
indent_size = 4

# GDScript files
[*.gd]
indent_size = 4
indent_style = tab

# Scene files
[*.tscn]
indent_style = space
indent_size = 2

[*.tres]
indent_style = space
indent_size = 2

# Project files
[*.csproj]
indent_size = 2

[*.sln]
indent_style = tab

# Config files
[*.{json,yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
